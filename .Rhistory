# Import the chromosome lengths for the second species
chromosome_lengths_praehirsuta <- import_chromosome_length("../Data/Reference_genomes/Jaera_praehirsuta_chromosomes.fasta.fai") %>%
# Add the species' name
mutate(Species = "praehirsuta")
# Bind the two tables together
all_chromosomes <- rbind(chromosome_lengths_albifrons, chromosome_lengths_praehirsuta)
# Chunk 14: Import_pafs
paf_folder <- "inst/extdata/paf/"
all_correspondences <- import_paf_from_folder(paf_folder) %>%
filter(query != "praehirsuta") %>%
# We also rename the chromsoomes to keep only the prefix (before the dot)
mutate(across(contains("name"), ~ str_split_fixed(., "\\.", 2)[, 1]))
all_correspondences %>%
head()
# Chunk 16: Ex_import_one_paf
import_paf("../Data/pafs/albifrons_aligned_on_praehirsuta.paf")
# Chunk 17: Correspondences_chroms
# Get the correspondences between the pairs of chromosomes
correspondence_chroms <- all_correspondences %>%
get_corresponding_chromosomes_species(all_chromosomes)
