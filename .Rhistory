# Chunk 7
align_ref_genomes <- function(paths_to_genomes, paf_folder = paste(getwd(), "pafs/", sep = "/")){
#' Align reference genomes
#' @description This way too long function is used to align reference genomes on one another.
#' It iterates on all unique combination of reference genomes to align them on one another. A part
#' of the function is tailored to my study as I am looking to align reference genomes in a specific
#' order. The lines can be commented if it is not useful and these lines will be indicated in commentary.
#' This function calls the minimap2 aligner using a bash script to run it in parallel for all the
#' combinations of reference genomes.
#'
#' @param paths_to_genomes This data frame contains the names of the species and the paths to the reference genomes.
#'
#' @param paf_folder This is a string containing the name of the folder where the paf files will be stored.
#'
#' @returns None
#'
run.alignment <- FALSE
# First, make sure that we have at least two genomes in the data frame and that the paths exist
if (dim(paths_to_genomes)[1] < 2){
stop("Please make sure that at least two reference genomes are provided for the alignments to take place.")
}
if (any(!file.exists(paths_to_genomes$paths))){
stop("Please make sure that all the provided paths exist.")
}
# Then, check if the data frame was already saved and if it is the same one
if (!file.exists(paste0(paf_folder, "/paths_to_genomes.Rdata"))){
save(paths_to_genomes, file = paste0(getwd(), "/paths_to_genomes.Rdata"))
run.alignment <- TRUE
}else{
recent_paths_to_genomes <- paths_to_genomes
load(paste0(paf_folder, "/paths_to_genomes.Rdata"))
if (length(setdiff(recent_paths_to_genomes, paths_to_genomes)) > 0){
paths_to_genomes <- recent_paths_to_genomes
save(paths_to_genomes, file = paste0(paf_folder, "/paths_to_genomes.Rdata"))
run.alignment <- TRUE
}
}
# Create the output file if it does not exist
if (!dir.exists(paf_folder)) dir.create(paf_folder, recursive = TRUE)
# Finally, if there was a change in the provided data frame, we will re-run the alignments
if (run.alignment){
paths_to_genomes <- paths_to_genomes %>%
mutate(Ref_species = lag(Species),
Ref_species_path = lag(paths)) %>%
drop_na()
for (row_nb in 1:nrow(paths_to_genomes)){
# Indicate the names of the query and target species
target_sp <- paths_to_genomes[row_nb, ]$Ref_species
target_sp_path <- paths_to_genomes[row_nb, ]$Ref_species_path
query_sp <- paths_to_genomes[row_nb, ]$Species
query_sp_path <- paths_to_genomes[row_nb, ]$paths
# Get the name of the output file
name_output <- paste0(
paf_folder,
query_sp,
"_aligned_on_",
target_sp,
".paf"
)
# Run minimap2 using the bash script on a cluster
system2(command = "sbatch",
args = paste("./run_minimap2_for_reference_genomes.sh",
target_sp_path, query_sp_path, name_output))
}
}
}
